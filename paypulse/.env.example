# Environment variables for PayPulse
# Never commit real credentials to version control

# PostgreSQL Database connection string for Prisma
DATABASE_URL="postgresql://postgres:password@localhost:5432/paypulse?schema=public"

# Application Base URL
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PayPal Sandbox Invoicing API (Server-side only - never expose to client)
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret_here"
PAYPAL_WEBHOOK_ID="your_paypal_sandbox_webhook_id_here"
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"

# Google Gemini AI Risk Analysis (Server-side only - never expose to client)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Cron Secret for Vercel Cron scheduled reminder dispatch
CRON_SECRET="your_cron_secret_token_here"


